{
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.test.ts",
    "**/__tests__/**",
    "jest.config.js"
  ],
  "rules": {
    "maxFileLines": 500,
    "maxFunctionLines": 50,
    "maxComplexity": 10,
    "maxNestingDepth": 4
  },
  "severity": {
    "todo-comment": "low",
    "console-log": "medium",
    "debugger": "high",
    "ts-ignore": "high"
  },
  "ruleExclusions": {
    "console-log": [
      "**/src/index.ts",
      "**/src/server/setup.ts"
    ],
    "type-assertion": [
      "**/src/server/inputParser.ts",
      "**/src/server/argValidation.ts",
      "**/src/server/formatters.ts",
      "**/src/config/languages.ts",
      "**/src/analyzers/dependencies/*.ts"
    ],
    "line-length": [
      "**/src/server/tools.ts"
    ],
    "nesting-depth": [
      "**/src/analyzers/*Analyzer.ts",
      "**/src/analyzers/swiftUiChecks.ts",
      "**/src/analyzers/swiftUiChecksPhase2.ts",
      "**/src/analyzers/dependencies/*.ts",
      "**/src/analyzers/baseAnalyzer.ts"
    ]
  },
  "customPatterns": [
    {
      "id": "prefer-nullish-coalescing",
      "pattern": "\\|\\|\\s+(?!(false|0|''|\"\"))",
      "message": "Consider using nullish coalescing (??) instead of ||",
      "severity": "low",
      "category": "code-quality",
      "suggestion": "Use ?? operator for null/undefined checks, reserve || for boolean coercion",
      "languages": ["typescript", "javascript"]
    },
    {
      "id": "avoid-non-null-assertion",
      "pattern": "\\w+!\\.",
      "message": "Non-null assertion operator (!) bypasses type safety",
      "severity": "medium",
      "category": "code-quality",
      "suggestion": "Use optional chaining (?.) or proper null checks instead",
      "languages": ["typescript"]
    }
  ]
}
