# Source files
src/
__tests__/
*.test.ts

# Configuration files
tsconfig.json
jest.config.js

# Claude Code contributor automation (hooks, rules, skills — not for npm consumers)
.claude/
# Claude Code plugin/marketplace manifest (not needed by npm consumers)
.claude-plugin/

# Git and GitHub
.git/
.github/
.gitignore

# Development files
.vscode/
.idea/
*.log
npm-debug.log*

# Test coverage
coverage/

# Documentation (keep README.md)
CONTRIBUTING.md
ARCHITECTURE.md
ROADMAP.md
RELEASE.md
NPM_SETUP.md
test_output.log
docs/

# MCPB build artifacts (generated by npm run mcpb:pack; not for npm consumers)
mcpb/staging/
mcpb/*.mcpb

# Temporary files
*.tmp
*.swp
*~

