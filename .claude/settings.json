{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-npm-publish.sh",
            "statusMessage": "Checking for local npm publish..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-tools-manifest-sync.sh",
            "statusMessage": "Checking tools.ts / mcpb manifest sync..."
          }
        ]
      }
    ]
  }
}
